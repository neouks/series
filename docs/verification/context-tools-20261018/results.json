  "contracts": {
    "context_search": {
      "default_types": [
        "fact",
        "finding",
        "intent"
      ],
      "default_limit": 10,
      "max_limit": 50,
      "query": "大小写不敏感字面匹配；活动需显式选择，不含推理或主/Planner会话",
      "cursor": "绑定条件与首次窗口上界；审批实时复核；不计算总数",
      "query_timeout_seconds": 5
    },
    "context_get": {
      "max_refs": 5,
      "default_max_chars": 8000,
      "max_chars": 24000,
      "refs": [
        "node:ID",
        "activity:ID"
      ],
      "views": [
        "detail",
        "output",
        "members"
      ],
      "read_protocol": "field 为 JSON Pointer；大字段返回 deferred 引用；next 可直接续读；结果受实际输出预算约束",
      "output": "is_final 与中途进度明确区分"
    },
    "asset_get": {
      "default_fields": [
        "identity",
        "fingerprint"
      ],
      "credential_field": "auth 需显式选择",
      "max_ids": 5,
      "projection": "授权、字段筛选和分页在同一 SQL 快照完成"
    },
    "traffic_search": {
      "host_required": true,
      "default_limit": 3,
      "max_limit": 10,
      "filters": [
        "method",
        "status",
        "since",
        "until",
        "contains",
        "body_contains"
      ],
      "body_index_max_bytes_per_side": 4194304,
      "binary_indexed": false
    },
    "traffic_get": {
      "parts": [
        "request_headers",
        "request_body",
        "response_headers",
        "response_body"
      ],
      "unit": "bytes",
      "max_bytes": 8192,
      "binary_encoding": "hex",
      "continuation": "next 中包含 id、part、offset；服务端定位 Blob，UTF-8 边界有效"
    },
    "roles": "Planner 严格审批；可信主 Agent/Worker 保留 pending 执行读取策略；其他绑定角色严格已审批；封禁/撤回继续拒绝。",
    "worker_preload": "当前意图和约束保留；最多20条上游事实/漏洞摘要和10条关联资产摘要；不自动读取全任务图和完整资产JSON。"
  },
